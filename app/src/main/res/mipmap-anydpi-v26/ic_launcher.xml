<?xml version="1.0" encoding="utf-8"?>
<!-- minSdk is 29, so the adaptive icon is the only launcher icon needed. The foreground is
     icons/icon.svg without its background square, rendered at 432px (108dp at xxxhdpi), scaled to sit inside the 66dp safe zone. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/launcher_background" />
    <foreground android:drawable="@drawable/ic_launcher_foreground" />
    <monochrome android:drawable="@drawable/ic_launcher_foreground" />
</adaptive-icon>
